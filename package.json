{
  "name": "notification",
  "version": "1.0.0",
  "description": "A LINE notification library for Bun supporting LINE Notify and LINE Messaging API",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:types && bun run build:esm && bun run build:cjs",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:esm": "bun build index.ts --outdir dist --format esm --target browser --outfile index.esm.js",
    "build:cjs": "bun build index.ts --outdir dist --format cjs --target node --outfile index.js",
    "dev": "bun run --watch index.ts",
    "test": "bun test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "line",
    "notification",
    "bun",
    "typescript",
    "line-notify",
    "line-messaging-api",
    "messaging",
    "chatbot",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/bun-notification.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/bun-notification/issues"
  },
  "homepage": "https://github.com/yourusername/bun-notification#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.8.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
